# Telegram Bot Configuration
TELE_TOKEN=your_telegram_bot_token_here
ADMIN_ID=your_telegram_chat_id_here

# Payment Gateway
PAKASIR_API_KEY=your_pakasir_api_key_here
PAKASIR_PROJECT=botspada
HARGA_BOT=1000
# Secret RANDOM PANJANG (min 32 char) untuk melindungi endpoint webhook Pakasir.
# Daftarin di Pakasir webhook URL: https://domain/webhook/pakasir/<PAKASIR_WEBHOOK_SECRET>
# Kalau attacker gak tau path-nya -> 404. Defense in depth + amount check + re-verify.
PAKASIR_WEBHOOK_SECRET=ganti_random_string_minimal_32_karakter

# Security
ENCRYPTION_KEY=your_64_character_encryption_key_here

# Server
PORT=3000

# Bot Configuration
MASA_AKTIF_HARI=30

# Proxy Configuration (untuk menghindari IP ban)
# Format: protocol://user:pass@host:port
# Bisa diisi multiple proxy, pisahkan dengan koma
# Contoh: http://user1:pass1@proxy1.com:8080,http://user2:pass2@proxy2.com:8080
# Bisa juga pakai SOCKS5: socks5://user:pass@host:port
PROXY_LIST=
# Rotasi proxy: per_user (1 proxy per user) atau per_request (ganti tiap request)
PROXY_MODE=per_request
